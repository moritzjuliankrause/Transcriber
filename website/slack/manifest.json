{
  "display_information": {
    "name": "Transcriber Blog",
    "description": "Posts blog drafts for review. Approve, request changes, or reject from Slack.",
    "background_color": "#0a0b0f"
  },
  "features": {
    "bot_user": { "display_name": "Transcriber Blog", "always_online": true }
  },
  "oauth_config": {
    "scopes": { "bot": ["chat:write", "chat:write.public"] }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://transcriber-blog-approval.REPLACE-WITH-YOUR-SUBDOMAIN.workers.dev"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
